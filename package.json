{
  "name": "nonecap",
  "version": "0.14.0",
  "description": "Official TypeScript client for NoneCap, the hCaptcha solver API.",
  "mcpName": "io.github.nonecap/nonecap",
  "type": "module",
  "license": "MIT",
  "author": "Lunium",
  "homepage": "https://nonecap.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonecap/nonecap-js.git"
  },
  "bugs": {
    "url": "https://github.com/nonecap/nonecap-js/issues"
  },
  "keywords": [
    "nonecap",
    "hcaptcha",
    "captcha",
    "captcha-solver",
    "hcaptcha-solver",
    "api-client",
    "sdk",
    "typescript",
    "mcp",
    "mcp-server",
    "model-context-protocol"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nonecap-mcp": "./dist/mcp.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "server.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
